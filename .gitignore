# Dependencies
node_modules/

# Environment — real files are NEVER committed
# Only .example templates are tracked in source control
.env
.env.*
!.env.example
!.env.docker.example
!.env.staging.example
!.env.production.example
!.env.test.example

# Secret vaults & key files — never commit these
secrets/
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.keystore
*.jks
serviceAccountKey.json
*credentials*.json

# Backups and database dumps
backups/
*.enc

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime and cache
.cache/
.tmp/
tmp/
coverage/
uploads/
backend/uploads/
.npm/
.expo/
.vite/
.pytest_cache/
.mypy_cache/
.venv/
__pycache__/
*.pyc
expo-env.d.ts

# Build output
dist/
build/
out/
web-build/
uml-diagrams/out/
uml-diagrams/docx-work/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
