# --- Git Line Ending Policy ---
# Normalize all text files to LF in the repository (consistent with editorconfig).

* text=auto eol=lf

# Explicitly LF
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.sh    text eol=lf
*.py    text eol=lf

# Binary - never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.jar   binary
*.pyd   binary
*.dll   binary
*.so    binary