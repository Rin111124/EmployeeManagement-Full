# ============================================================
# Docker Compose Environment Variables Template
# Copy this file to .env.docker and fill in real values.
# NEVER commit .env.docker to version control.
# Compose uses this file for interpolation; containers receive only explicitly mapped variables.
# ============================================================

# ---- Nginx Reverse Proxy ----
# For local HTTP on port 80: ./deployment/nginx/nginx.conf
# For production HTTPS on port 443 with TLS certs: ./deployment/nginx/nginx.prod.conf
NGINX_CONF_FILE=./deployment/nginx/nginx.conf

# ---- MongoDB ----
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-strong-password

# ---- Admin Backend ----
JWT_SECRET=replace-with-at-least-64-random-chars
JWT_ACCESS_SECRET=replace-with-at-least-64-random-access-chars
JWT_REFRESH_SECRET=replace-with-at-least-64-random-refresh-chars
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ENCRYPTION_KEY_VERSION=v1
# During rotation, retain the previous key as APP_ENCRYPTION_KEY_V1 until data migration is verified.
# APP_ENCRYPTION_KEY_V1=old-64-hex-key
# Path to 64-hex-character backup key file
BACKUP_ENCRYPTION_KEY_FILE=./deployment/secrets/backup-encryption-key.hex
NODE_ENV=development
# Set this to the public HTTPS origin in production, e.g. https://hr.example.com or * for local dev
CORS_ORIGIN=*
# Same-origin API path; nginx routes this to admin-backend.
VITE_API_BASE=/api/v1
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CHATBOT_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# ---- Attendance Service ----
SYNC_SECRET=replace-with-at-least-32-random-chars
AI_ATTESTATION_SECRET=replace-with-at-least-32-random-chars-shared-by-admin-and-attendance
ATTENDANCE_SERVICE_URL=http://attendance-service:5001/api
# Production must reject unsigned attendance sync requests (true). Set false for dev/testing.
REQUIRE_SYNC_SIGNATURE=false

# ---- AI Service ----
AI_ENVIRONMENT=development
AI_API_KEY=replace-with-a-random-api-key-for-ai-service
# Set to true only in production with a licensed PAD ONNX model
LIVENESS_ENABLED=false
# Path to PAD ONNX model file (only needed if LIVENESS_ENABLED=true)
LIVENESS_MODEL_FILE=./deployment/secrets/empty.onnx
LIVENESS_THRESHOLD=0.80

# ---- Network Isolation ----
# Set true for air-gapped production with zero outbound internet traffic
INTERNAL_NET_IS_INTERNAL=false
