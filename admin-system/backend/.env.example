# =============================================================
# Admin Backend — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Generate strong random secrets with:
#   node -e "const c=require('crypto'); console.log(c.randomBytes(48).toString('base64'))"
#   node -e "const c=require('crypto'); console.log(c.randomBytes(32).toString('hex'))"
# =============================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/employee_management

# ── JWT Secrets (generate with node crypto, min 32 chars) ────────────────────
JWT_SECRET=REPLACE_WITH_node_randomBytes_48_base64
JWT_ACCESS_SECRET=REPLACE_WITH_node_randomBytes_48_base64
JWT_REFRESH_SECRET=REPLACE_WITH_node_randomBytes_48_base64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Rate Limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=2mb

# ── Initial Admin Account (used by seed:admin script only) ───────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_strong_password
ADMIN_EMPLOYEE_CODE=ADMIN001
ADMIN_FULL_NAME=System Administrator

# ── Inter-service Authentication ─────────────────────────────────────────────
# Must match the SYNC_SECRET in attendance-service/.env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET=REPLACE_WITH_node_randomBytes_32_hex
ATTENDANCE_SERVICE_URL=http://localhost:5001/api

# ── AI Chatbot ───────────────────────────────────────────────────────────────
# CHATBOT_PROVIDER: "gemini" or "openai"
CHATBOT_PROVIDER=gemini

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Error Monitoring (optional) ───────────────────────────────────────────────
# Get from: https://sentry.io (free tier available)
SENTRY_DSN=

# ── Data Encryption (at-rest encryption for PII fields) ──────────────────────
# Required in production. Used by cryptoVault.js to encrypt sensitive fields (bank accounts, face data, etc.)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_node_randomBytes_32_hex

# ── Redis (optional — enables bulk payroll queue & dashboard caching) ─────────
# If not set, bulk payroll jobs and caching are gracefully disabled.
# Install Redis locally: https://redis.io/docs/install/
# Or use a managed service: Upstash (free tier), Redis Cloud, etc.
REDIS_URL=redis://localhost:6379
