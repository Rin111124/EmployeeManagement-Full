# ==============================================================================
# Production Environment Variables Template (.env.production.example)
#
# Bắt buộc cho môi trường chạy dữ liệu nhân sự thật.
# KHÔNG BAO GIỜ commit file .env.docker hoặc .env chứa key thật lên Git!
# ==============================================================================

# ---- Môi trường & Nginx TLS Reverse Proxy ----
NODE_ENV=production
NGINX_CONF_FILE=./deployment/nginx/nginx.prod.conf
CORS_ORIGIN=https://hr.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
VITE_API_BASE=/api/v1

# ---- Cơ sở dữ liệu MongoDB ----
# Khuyến nghị dùng Replica Set để hỗ trợ ACID Transactions giữa Attendance & Outbox
MONGODB_URI=mongodb://admin:STRONG_PASSWORD_HERE@mongodb:27017/employee_management?authSource=admin
ATTENDANCE_MONGODB_URI=mongodb://admin:STRONG_PASSWORD_HERE@mongodb:27017/attendance?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=GENERATE_STRONG_PASSWORD_32_CHARS

# ---- Mã hóa dữ liệu PII & Sinh trắc học (AES-256-GCM) ----
# Tạo key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Phải khớp 100% giữa Admin Backend và Attendance Service
APP_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_FOR_APP_ENCRYPTION
APP_ENCRYPTION_KEY_VERSION=v1
APP_ENCRYPTION_KEY_V1=GENERATE_64_HEX_CHARACTERS_FOR_APP_ENCRYPTION

# Khóa mã hóa bản sao lưu offsite
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key

# ---- Khóa xác thực phiên & JWT (Tối thiểu 64 ký tự ngẫu nhiên) ----
JWT_SECRET=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS_FOR_JWT
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS_FOR_REFRESH_TOKEN

# ---- Ký kết đồng bộ Outbox/Inbox (HMAC-SHA256, tối thiểu 32 ký tự) ----
SYNC_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS_FOR_SYNC
REQUIRE_SYNC_SIGNATURE=true

# ---- Xác thực Sinh trắc học & Liveness (HMAC Attestation) ----
AI_ATTESTATION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS_FOR_ATTESTATION
REQUIRE_LIVENESS=true
REQUIRE_LIVENESS_ATTESTATION=true

# ---- AI Engine (InsightFace + ONNX PAD) ----
AI_ENVIRONMENT=production
AI_API_KEY=GENERATE_SECURE_API_KEY_FOR_AI_SERVICE
LIVENESS_ENABLED=true
LIVENESS_THRESHOLD=0.75
LIVENESS_MODEL_FILE=./deployment/secrets/liveness.onnx

# ---- Cô lập mạng nội bộ ----
INTERNAL_NET_IS_INTERNAL=true
