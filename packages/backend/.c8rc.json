{
  "all": true,
  "include": [
    "controllers/**/*.js",
    "services/**/*.js",
    "middlewares/**/*.js",
    "models/**/*.js",
    "routes/**/*.js",
    "utils/**/*.js",
    "validators/**/*.js"
  ],
  "exclude": [
    "tests/**",
    "scripts/**",
    "coverage/**",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "lcov"
  ],
  "lines": 72,
  "statements": 72,
  "check-coverage": true
}
