PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/attendance
ADMIN_URL=http://localhost:5000/api/v1
SYNC_SECRET=replace-with-at-least-32-random-chars
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Giai đoạn 2 — Mã hóa biometric data (AES-256-GCM)
# PHẢI khớp với APP_ENCRYPTION_KEY trong packages/backend/.env
# để embedding được sync từ Admin có thể decrypt được tại đây.
# Tạo key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace-with-same-key-as-admin-backend
APP_ENCRYPTION_KEY_VERSION=v1

# Khi rotation key, thêm:
# APP_ENCRYPTION_KEY_V1=old-key-value
# APP_ENCRYPTION_KEY_V2=new-key-value
# APP_ENCRYPTION_KEY_VERSION=v2

# AI Service (chia sẻ cùng URL và key với Admin Backend)
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=replace-with-ai-api-key

# Attestation secret (nếu dùng signed liveness attestation)
# PHẢI khớp với AI_ATTESTATION_SECRET trong packages/backend/.env
AI_ATTESTATION_SECRET=replace-with-attestation-secret
