# ==============================================================================
# AI Service (Python/FastAPI) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the ai-service directory:
#   cp .env.example .env
#
# NEVER commit .env with real values to source control.
#
# Environment-specific files:
#   .env.example          — Development defaults (this file)
#   .env.staging.example  — Staging template
#   .env.production.example — Production template (all values REQUIRED)
# ==============================================================================

# ─── Service ──────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000

# ─── Authentication ───────────────────────────────────────────────────────────
# API key required for all requests to this service.
# Must match AI_API_KEY in admin-system and attendance-service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AI_API_KEY=dev-ai-api-key-replace-with-random-value

# ─── CORS / Allowed Callers ───────────────────────────────────────────────────
# Comma-separated list of allowed origins or internal service IPs
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5000

# ─── Model Configuration ──────────────────────────────────────────────────────
# Path to face recognition model weights
MODEL_PATH=./models/face_recognition.pkl
# Detection confidence threshold (0.0 – 1.0). DO NOT use this value in production.
# Production threshold must be set from benchmark results (see P1-BIO-04).
CONFIDENCE_THRESHOLD=0.80

# ─── Performance ──────────────────────────────────────────────────────────────
# Maximum concurrent inference workers
MAX_WORKERS=2
# Inference timeout in seconds
INFERENCE_TIMEOUT_SECONDS=10
# Maximum upload size in bytes (5 MB default)
MAX_UPLOAD_BYTES=5242880

# ─── Liveness Detection ───────────────────────────────────────────────────────
# Enable liveness detection (requires liveness model)
LIVENESS_ENABLED=false
LIVENESS_MODEL_PATH=./models/liveness.pkl

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# IMPORTANT: NEVER log image payloads, embeddings or face data
LOG_IMAGE_PAYLOAD=false

# ─── Error Monitoring ─────────────────────────────────────────────────────────
SENTRY_DSN=
