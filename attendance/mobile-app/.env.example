# Public Expo configuration for the kiosk app.
# Copy this file to .env and keep .env out of version control.
#
# These EXPO_PUBLIC_* values are bundled into the mobile app.
# Do not put API keys, JWTs, device tokens, database URLs, or passwords here.

# Optional shared host. Used only when the specific URLs below are empty.
EXPO_PUBLIC_API_HOST=hr.example.com

# HTTPS endpoints exposed by the reverse proxy.
EXPO_PUBLIC_ADMIN_URL=https://hr.example.com
# AI requests are proxied through the authenticated admin API. Do not expose
# the AI service or its API key in the mobile app.
EXPO_PUBLIC_ATTENDANCE_URL=https://hr.example.com/attendance/api

# Security note:
# Never add credentials or secrets to EXPO_PUBLIC_* variables.
